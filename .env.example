# Shared / local (docker compose up --build)
# ---------------------------------------------------------------------------

# Database
POSTGRES_DB=booka
POSTGRES_USER=booka
POSTGRES_PASSWORD=booka_secret
DATABASE_URL=jdbc:postgresql://postgres:5432/booka

# Backend
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# RAG
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_PUBLIC_RATE_LIMIT=20
RAG_STAFF_RATE_LIMIT=60

# Stripe Checkout (deferred — guest bookings skip Checkout; set keys when re-enabling)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/book?payment=success
STRIPE_CANCEL_URL=http://localhost:5173/book?payment=cancelled
STRIPE_CURRENCY=usd

# Channel / OTA inbound API key (X-Channel-Api-Key)
CHANNEL_API_KEY=dev-channel-key

# Frontend: local Vite (`npm run dev`) points at the backend port.
# Docker frontend image: leave empty (or unset) so the SPA calls same-origin /api (nginx proxies).
# Prod CI already builds with VITE_API_BASE_URL= empty — do not set a different API host in prod.
VITE_API_BASE_URL=http://localhost:8080

# Optional local image uploads (hotel/room photos). URL-only images work without this.
# Files land under BOOKA_UPLOAD_DIR and are served at /uploads/**.
BOOKA_UPLOAD_DIR=uploads
# BOOKA_UPLOAD_MAX_BYTES=5242880

# CORS — comma-separated Spring allowedOriginPatterns (credentials enabled; cannot use * alone).
# Browsers send Origin on JSON POSTs even for same-origin /api via nginx.
# Local compose default already includes juneko + localhost patterns.
CORS_ALLOWED_ORIGINS=https://booka.juneko.online,https://*.juneko.online,http://localhost:*,http://127.0.0.1:*

# ---------------------------------------------------------------------------
# Production VPS (docker-compose.prod.yml) — copy this file to DEPLOY_PATH/.env
# and set strong secrets. Image names must match GitHub Actions tags.
# See docs/VPS_DOCKER_CICD.md (including HTTPS / Caddy section).
# ---------------------------------------------------------------------------
# DOCKERHUB_USERNAME=your-dockerhub-user
# DOMAIN=booka.juneko.online
# SPRING_PROFILES_ACTIVE=prod
# POSTGRES_PASSWORD=use-a-strong-password
# JWT_SECRET=use-a-long-random-secret-at-least-32-chars
# Exact CORS line for booka.juneko.online (required if .env overrides compose defaults):
# CORS_ALLOWED_ORIGINS=https://booka.juneko.online,https://*.juneko.online,http://localhost:*,http://127.0.0.1:*
# STRIPE_SUCCESS_URL=https://booka.juneko.online/book?payment=success
# STRIPE_CANCEL_URL=https://booka.juneko.online/book?payment=cancelled
